# Response headers for every page Cloudflare serves (Workers static assets
# read this file from the root of _site).
#
# Referrer-Policy matters most here: a trip page's address carries the
# passenger's private link (?t=…). Without this, tapping "Open the map" or the
# card page would send that whole address to Google or Fygaro as the referrer.
# With it, other sites see only "paradiseseaexpress.com".
/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=()

# Staff boards and private trip pages stay out of search engines, whatever a
# crawler makes of the meta tag.
/control/*
  X-Robots-Tag: noindex, nofollow
/captain/*
  X-Robots-Tag: noindex, nofollow
/trip/*
  X-Robots-Tag: noindex, nofollow
