{
  "expo": {
    "name": "Paradise Captain",
    "slug": "paradise-captain",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paradiseseaexpress.captain",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.paradiseseaexpress.captain",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "useNextNotificationsApi": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "paradisecaptain",
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0bbcd6",
          "sounds": [
            "./assets/run_alert.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Paradise Sea Express shows the office and your passengers where your boat is while you are switched on as available. Switch off and it stops, and your last position is deleted.",
          "locationWhenInUsePermission": "Paradise Sea Express shows the office and your passengers where your boat is while you are switched on as available. Switch off and it stops, and your last position is deleted.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
