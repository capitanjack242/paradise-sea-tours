{
  // The site is static files (`_site`, made by scripts/build-site.sh, which Cloudflare runs as
  // the build command) plus one small piece of server code, worker/index.js, for "Ask us", the
  // chat on the website. Only /api/* reaches the worker; every other address is a file,
  // served as before.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paradise-sea-express",
  "compatibility_date": "2026-08-19",
  "main": "worker/index.js",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    // A missing path gets web/404.html, still with a 404 status.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Questions to the chat: at most 10 a minute from one address.
  "ratelimits": [
    { "name": "ASK_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
  // ANTHROPIC_API_KEY is a secret, set in the Cloudflare dashboard, never in this file.
}
