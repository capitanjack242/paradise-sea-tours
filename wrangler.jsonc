{
  // The site is static — there is no Worker code, only files. Cloudflare serves
  // the assets directly and this file just says where they are.
  //
  // `_site` is produced by scripts/build-site.sh, which Cloudflare runs as the
  // build command. GitHub Pages served the same tree until it was retired on
  // 19 Aug 2026; this is the only host now.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paradise-sea-express",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./_site",
    // A missing path gets web/404.html, still with a 404 status.
    "not_found_handling": "404-page"
  }
}
