{
  // The site is static — there is no Worker code, only files. Cloudflare serves
  // the assets directly and this file just says where they are.
  //
  // `_site` is produced by scripts/build-site.sh, the same script GitHub Pages
  // runs, so both deploys serve an identical tree while we run them in parallel.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paradise-sea-express",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./_site",
    // There is no 404 page yet, so leave the default: a missing path returns a
    // plain 404 rather than being redirected somewhere misleading. Switch this
    // to "404-page" once web/404.html exists.
    "not_found_handling": "none"
  }
}
